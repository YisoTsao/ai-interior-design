# 複製為 .env。本機開發不需要任何雲端金鑰（AI 走 mock）。
NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/interiorai
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=interiorai
JWT_SECRET=change-me-in-real-envs
AI_PROVIDER=mock            # mock | openai | flux
MODELS_CONFIG=services/api/models.yaml
CV_SERVICE_URL=http://localhost:8100
# 以下僅在做真實供應商驗證時填入；絕不可提交到 git，也不可進前端 bundle。
OPENAI_API_KEY=
BFL_API_KEY=

# 身分驗證：none＝不需登入（開發預設，所有請求以本機使用者處理）；jwt＝需 Bearer JWT（test／production 預設）
AUTH_MODE=none
# 物件儲存：s3（S3 相容／MinIO，目前實作）；supabase（介面已定義、尚未實作）
STORAGE_PROVIDER=s3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=interiorai
# 前端（Vite，build 時注入）
# VITE_API_URL=http://localhost:3000/v1
# VITE_CV_URL=http://localhost:8100     # 設定時，平面圖點陣辨識優先用 cv-service（有 OCR）；未設定＝瀏覽器辨識
# VITE_STORAGE_PROVIDER=s3              # supabase 尚未實作
