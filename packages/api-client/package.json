{
  "name": "@interiorai/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/specs/openapi.yaml -o src/schema.gen.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "openapi-typescript": "^7",
    "vitest": "^5.0.2"
  }
}
