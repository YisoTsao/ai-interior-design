{
  "name": "interiorai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "size": "echo 'TODO(P7): bundle size budget' && exit 1",
    "licenses:check": "node tools/licenses-check.mjs && pnpm catalog check",
    "catalog": "pnpm --filter @interiorai/catalog-tools --silent catalog",
    "prepare": "simple-git-hooks || true",
    "ai-eval": "pnpm --filter @interiorai/ai-eval --silent run"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm exec prettier --check --no-error-on-unmatched-pattern \"packages/**/*.{ts,tsx,json}\" \"apps/**/*.{ts,tsx,json}\" \"services/**/*.{ts,json}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
