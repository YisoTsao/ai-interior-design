{
  "name": "interiorai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "format": "prettier --write .",
    "test:e2e": "echo 'TODO(P2): playwright (e2e/)' && exit 1",
    "test:integration": "echo 'TODO(P3): testcontainers' && exit 1",
    "test:contract": "echo 'TODO(P3): openapi contract' && exit 1",
    "size": "echo 'TODO(P7): bundle size budget' && exit 1",
    "licenses:check": "echo 'TODO(P2): license scan' && exit 1",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm exec prettier --check --no-error-on-unmatched-pattern \"packages/**/*.{ts,tsx,json}\" \"apps/**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
