{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interiorai.local/schemas/scene-1.4.0.json",
  "title": "Scene Graph v1.4.0",
  "description": "唯一事實來源。長度單位一律為 mm 整數；座標為 (x, z) 平面，Y 軸向上；角度為弧度。；上限與座標範圍為〔假設〕，見 ADR-013。",
  "type": "object",
  "required": ["schemaVersion", "units", "levels"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "units": {
      "const": "mm"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      },
      "description": "命名視角書籤；視埠相機為 UI 暫態，不入 Scene（ADR-001）",
      "maxItems": 100
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "lightScenes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/lightScene"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-]+$",
      "description": "程式產生用『前綴_ULID』；可讀 ID（如 w_01）僅限 fixtures（ADR-013）"
    },
    "mm": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "level": {
      "type": "object",
      "required": ["id", "elevation", "height", "walls", "openings", "rooms", "objects"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "elevation": {
          "$ref": "#/$defs/mm"
        },
        "height": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 6000
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          },
          "maxItems": 5000
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          },
          "maxItems": 10000
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/room"
          },
          "maxItems": 1000
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "maxItems": 5000
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "slabThickness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "a", "b", "thickness"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "a": {
          "$ref": "#/$defs/vec2"
        },
        "b": {
          "$ref": "#/$defs/vec2"
        },
        "thickness": {
          "type": "integer",
          "minimum": 20,
          "maximum": 600
        },
        "type": {
          "enum": ["structural", "exterior", "partition", "curtain"]
        },
        "materialId": {
          "$ref": "#/$defs/id"
        },
        "materialIdB": {
          "$ref": "#/$defs/id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 6000
        },
        "baseboard": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "appearanceB": {
          "$ref": "#/$defs/appearance"
        },
        "tilingA": {
          "$ref": "#/$defs/tiling"
        },
        "tilingB": {
          "$ref": "#/$defs/tiling"
        },
        "wainscot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "style", "sides"],
          "properties": {
            "height": {
              "type": "integer",
              "minimum": 300,
              "maximum": 2000
            },
            "style": {
              "enum": ["flat", "panel", "beadboard"]
            },
            "sides": {
              "enum": ["A", "B", "both"]
            },
            "materialId": {
              "$ref": "#/$defs/id"
            },
            "color": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "crown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["height", "profile"],
          "properties": {
            "height": {
              "type": "integer",
              "minimum": 20,
              "maximum": 300
            },
            "profile": {
              "enum": ["flat", "cove", "step"]
            }
          }
        },
        "baseboardProfile": {
          "enum": ["flat", "cove", "step"]
        },
        "arcGroup": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "opening": {
      "type": "object",
      "required": ["id", "wallId", "type", "offset", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "wallId": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["door", "window", "passage"]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "從牆 a 端沿牆到開口起點的距離"
        },
        "width": {
          "type": "integer",
          "minimum": 200
        },
        "height": {
          "type": "integer",
          "minimum": 200
        },
        "sill": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "swing": {
          "enum": ["left", "right", "double", "sliding", "none"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "style": {
          "enum": [
            "single",
            "double",
            "unequal",
            "sliding",
            "folding",
            "pocket",
            "casement",
            "fixed",
            "awning",
            "bay",
            "corner",
            "arch"
          ]
        },
        "openAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "wallIds"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "wallIds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "floorMaterialId": {
          "$ref": "#/$defs/id"
        },
        "ceilingMaterialId": {
          "$ref": "#/$defs/id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "floorAppearance": {
          "$ref": "#/$defs/appearance"
        },
        "ceilingAppearance": {
          "$ref": "#/$defs/appearance"
        },
        "floorTiling": {
          "$ref": "#/$defs/tiling"
        },
        "kind": {
          "enum": [
            "living",
            "dining",
            "bedroom",
            "kitchen",
            "bath",
            "study",
            "entry",
            "balcony",
            "storage",
            "other"
          ]
        },
        "ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dropMm", "borderMm"],
          "description": "天花造型（v1.3，FE-FIN-03）",
          "properties": {
            "type": {
              "enum": ["flat", "drop", "tray", "cove"]
            },
            "dropMm": {
              "type": "integer",
              "minimum": 30,
              "maximum": 800
            },
            "borderMm": {
              "type": "integer",
              "minimum": 150,
              "maximum": 2000
            },
            "coveKelvin": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 6500
            },
            "coveLumensPerM": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000
            }
          }
        }
      }
    },
    "object": {
      "type": "object",
      "required": ["id", "catalogId", "position", "rotationY"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "catalogId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "$ref": "#/$defs/vec3",
          "description": "[x, y, z] mm；y 為離地高度"
        },
        "rotationY": {
          "type": "number"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "params": {
          "type": "object",
          "description": "參數化模組的參數"
        },
        "materialOverrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "locked": {
          "type": "boolean"
        },
        "roomId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "light": {
          "$ref": "#/$defs/lightOverride"
        },
        "groupId": {
          "$ref": "#/$defs/id"
        },
        "mirrored": {
          "type": "boolean"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["dimension", "text", "note", "angle", "arrow", "tag"]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["id", "position", "target", "fovDeg"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "target": {
          "$ref": "#/$defs/vec3"
        },
        "fovDeg": {
          "type": "number",
          "minimum": 10,
          "maximum": 120
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "createdBy": {
          "type": "string"
        },
        "source": {
          "enum": ["manual", "import-vector", "import-raster", "template"]
        },
        "scale": {
          "type": "object",
          "properties": {
            "method": {
              "enum": ["dimension_ocr", "user", "dxf_units", "unknown"]
            }
          }
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "description": "外觀覆寫（v1.1，ADR-023）：只影響呈現",
      "properties": {
        "color": {
          "$ref": "#/$defs/hex"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "opacity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "castShadow": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "uvScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "uvRotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "uvOffset": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "lightOverride": {
      "type": "object",
      "additionalProperties": false,
      "description": "燈具光源覆寫（v1.1，ADR-023）",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "lumens": {
          "type": "number",
          "minimum": 0,
          "maximum": 200000
        },
        "kelvin": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 12000
        },
        "color": {
          "$ref": "#/$defs/hex"
        },
        "beamDeg": {
          "type": "number",
          "minimum": 5,
          "maximum": 170
        },
        "penumbra": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tiltDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "panDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "castShadow": {
          "type": "boolean"
        },
        "shadowSoftness": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "rangeMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "場景環境（v1.1）",
      "properties": {
        "sky": {
          "enum": ["moonless", "moonlit", "city", "dusk"]
        },
        "exposureEv": {
          "type": "number",
          "minimum": -6,
          "maximum": 6
        },
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "sunAzimuthDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "sunElevationDeg": {
          "type": "number",
          "minimum": 2,
          "maximum": 90
        },
        "sunIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "tiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "tileW", "tileH"],
      "description": "鋪貼設計（v1.2）",
      "properties": {
        "pattern": {
          "enum": [
            "straight",
            "running",
            "diagonal",
            "herringbone",
            "chevron",
            "basketweave",
            "hexagon",
            "versailles"
          ]
        },
        "tileW": {
          "type": "integer",
          "minimum": 20,
          "maximum": 3000
        },
        "tileH": {
          "type": "integer",
          "minimum": 20,
          "maximum": 3000
        },
        "grout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "groutColor": {
          "$ref": "#/$defs/hex"
        },
        "rotationDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500
        },
        "borderMaterialId": {
          "$ref": "#/$defs/id"
        },
        "waste": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "lightScene": {
      "type": "object",
      "required": ["id", "name", "states"],
      "additionalProperties": false,
      "description": "燈光情境（v1.4）",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["on"],
            "additionalProperties": false,
            "properties": {
              "on": {
                "type": "boolean"
              },
              "level": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
